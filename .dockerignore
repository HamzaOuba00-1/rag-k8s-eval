# Build context of the Docker image: everything is excluded, then only what the
# Dockerfile copies is let back in. Keep in sync with .gcloudignore.
/*
!/Dockerfile
!/requirements-app.txt
!/pyproject.toml
!/README.md
!/LICENSE
!/NOTICE
!/src/
!/app/
!/web/
/web/node_modules/
/web/dist/
/web/*.tsbuildinfo
!/data/
/data/*
!/data/index/
/data/index/*/*
!/data/index/*/chunks.jsonl
!/data/index/*/bm25_tokens.json
!/data/index/*/dense.faiss
!/models/
/models/*
!/models/onnx/
/models/onnx/*
!/models/onnx/embedder/
/models/onnx/embedder/*
!/models/onnx/embedder/model.onnx
!/models/onnx/embedder/tokenizer.json
!/models/onnx/embedder/ragk8s_onnx.json
!/app_data/
/app_data/*
!/app_data/bundle.json
__pycache__/

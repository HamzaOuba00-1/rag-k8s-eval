# Python environments and caches
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets
.env

# Corpus snapshot: data/raw/ IS tracked on purpose (frozen corpus, ~5 MB,
# CC BY 4.0, see NOTICE). Gold questions reference its doc_ids.
# Derived artifacts are rebuilt by the pipeline and are not tracked:
data/_k8s_website_clone/
data/processed/
data/index/
*.faiss
*.pkl

# Jupyter
.ipynb_checkpoints/

# Evaluation caches and intermediate files (regenerable)
.cache/
eval/questions_candidates.jsonl

# Raw run outputs are untracked until the final, reported runs are produced;
# the tracking policy for final results is defined in a later step.
results/run_*.jsonl
results/scores_*.csv
results/summary_*.json
results/retrieval/
results/runs/

# Web app data bundle, rebuilt from the results by `python -m ragk8s app-bundle`
app_data/

# Front-end dependencies and build output (rebuilt by npm ci && npm run build)
web/node_modules/
web/dist/
web/*.tsbuildinfo

# Packaging artifacts
*.egg-info/
build/
dist/

# Archives built for Kaggle datasets and outputs downloaded from Kaggle
kaggle/export/
kaggle/output/

# Exported ONNX models (rebuilt with `python -m ragk8s onnx export`)
models/

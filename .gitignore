# Derived artifacts are rebuilt by the pipeline and are not tracked:
data/_k8s_website_clone/
data/processed/
data/index/
*.faiss
*.pkl

# Jupyter
.ipynb_checkpoints/

# Evaluation caches and intermediate files (regenerable)
.cache/
eval/questions_candidates.jsonl

# Raw run outputs are untracked until the final, reported runs are produced;
# the tracking policy for final results is defined in a later step.
results/run_*.jsonl
results/scores_*.csv
results/summary_*.json

# Packaging artifacts
*.egg-info/
build/
dist/
